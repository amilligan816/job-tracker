# Copy to .env and adjust. Never commit .env.

# Host ports are shifted off the defaults (5432/9000/9001) so this stack can run
# alongside other local projects. Change freely -- nothing hardcodes them.

# ---------- Postgres ----------
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=jobtracker
POSTGRES_PORT=5433

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-dev
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
S3_BUCKET=job-tracker

# Endpoint the backend uses to reach MinIO (inside the compose network).
S3_ENDPOINT_URL=http://minio:9000
# Endpoint baked into presigned URLs handed to the browser (must be reachable
# from the host, not from inside the network).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002

# ---------- Backend ----------
BACKEND_PORT=8000
# Overridden inside compose; this value is for running the backend on the host.
DATABASE_URL=postgresql+asyncpg://jobtracker:change-me-in-dev@localhost:5433/jobtracker
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---------- Claude assistant ----------
# Leave blank to run with assistant features disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
