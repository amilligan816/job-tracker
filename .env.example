# Copy to .env and adjust. Never commit .env.

# Host ports are shifted off the defaults (5432/9000/9001) so this stack can run
# alongside other local projects. Change freely -- nothing hardcodes them.

# ---------- Postgres ----------
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=jobtracker
POSTGRES_PORT=5433

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-dev
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
S3_BUCKET=job-tracker

# Endpoint the backend uses to reach MinIO (inside the compose network).
S3_ENDPOINT_URL=http://minio:9000
# Endpoint baked into presigned URLs handed to the browser (must be reachable
# from the host, not from inside the network).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002

# ---------- Backend ----------
BACKEND_PORT=8000
# Overridden inside compose; this value is for running the backend on the host.
DATABASE_URL=postgresql+asyncpg://jobtracker:change-me-in-dev@localhost:5433/jobtracker
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---------- Claude assistant ----------
# Leave all of these unset to run with assistant features disabled; everything
# else (match ratings, untailored resumes, tracking) works without them.
#
# A Console API key is the supported way to authenticate an application:
#   https://console.anthropic.com/settings/keys
# A Claude Pro/Max subscription is not an API credential and cannot be used here.
ANTHROPIC_API_KEY=

# Alternatives, if your setup authenticates differently:
#   ANTHROPIC_AUTH_TOKEN   an OAuth access token
#   ANTHROPIC_AMBIENT_AUTH set true when the credential is already on disk for
#                          the SDK to find (an `ant auth login` profile, or
#                          workload identity). In Docker you must also mount it:
#                          ~/.config/anthropic -> /root/.config/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_AMBIENT_AUTH=false

# Cost lever: claude-sonnet-5 and claude-haiku-4-5 are cheaper per token.
ANTHROPIC_MODEL=claude-opus-5

# ---------- Email sync (Gmail) ----------
# Optional. Without these the Email page says so and the rest of the app is
# unaffected -- no routes 503, nothing else changes.
#
# Setting up the Google OAuth client (about five minutes):
#   1. https://console.cloud.google.com/ -> create or pick a project
#   2. APIs & Services -> Library -> enable "Gmail API"
#   3. APIs & Services -> OAuth consent screen -> External, add yourself as a
#      test user. It can stay in "Testing"; publishing is for multi-user apps.
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application
#   5. Add the redirect URI below, verbatim, under "Authorized redirect URIs"
#
# The app requests gmail.readonly and nothing else: it reads mail, and cannot
# send, label, archive or delete.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/oauth/google/callback
# Where the OAuth callback sends the browser back to.
FRONTEND_BASE_URL=http://localhost:5173

# Encrypts the stored OAuth tokens. Required to connect a mailbox. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later invalidates the stored tokens and forces a reconnect.
MAIL_TOKEN_KEY=

# How often connected mailboxes are polled, in seconds. 0 turns the background
# loop off and leaves the "Sync now" button working.
MAIL_SYNC_INTERVAL_SECONDS=900
# How far back the first sync of a mailbox reaches.
MAIL_LOOKBACK_DAYS=30
# Ceiling on one run. A long-dormant mailbox is caught up over several runs.
MAIL_MAX_MESSAGES_PER_SYNC=200
# Let Claude adjudicate the emails the string matching is unsure about. Needs a
# Claude credential above; with none, the heuristics run alone.
MAIL_USE_CLAUDE=true

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
